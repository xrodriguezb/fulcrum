# Copy to .env and adjust. Values here are placeholders, never real credentials.

FULCRUM_ENV=development
LOG_LEVEL=info
SERVICE_NAME=fulcrum

# The application role is not the schema owner. See docs/security.md.
DATABASE_URL=postgres://fulcrum_app:change-me@localhost:5432/fulcrum?sslmode=disable
# Migrations need rights the request path must not have, so they connect as the
# owner. Left empty, DATABASE_URL is used and the application role must own the
# schema, which is only appropriate for a throwaway database.
MIGRATION_DATABASE_URL=
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m

NATS_URL=nats://localhost:4222
NATS_STREAM=FULCRUM
NATS_SUBJECT_PREFIX=fulcrum.events
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
# Negative means reconnect forever, which is what a worker whose whole job is
# publishing should do.
NATS_MAX_RECONNECTS=-1
NATS_PUBLISH_TIMEOUT=5s

HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=65536
CORS_ALLOWED_ORIGINS=http://localhost:5173

WORKER_METRICS_PORT=8081
WORKER_SHUTDOWN_TIMEOUT=20s

OUTBOX_WORKERS=4
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BACKOFF_BASE=200ms
OUTBOX_BACKOFF_CAP=30s
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_DRAIN_TIMEOUT=15s
# How long a claimed event stays invisible to other publishers. It must outlast
# NATS_PUBLISH_TIMEOUT, or a second publisher takes an event the first one is
# still sending. A publisher that dies mid publish strands its events for this
# long, so shortening it trades duplicate publications for faster recovery.
OUTBOX_CLAIM_LEASE=30s

CONSUMER_NAME=order-projector
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_RETRY_BASE=100ms
CONSUMER_RETRY_CAP=30s
CONSUMER_ACK_WAIT=30s
CONSUMER_FETCH_BATCH=25
CONSUMER_DRAIN_TIMEOUT=15s

IDEMPOTENCY_TTL=24h
IDEMPOTENCY_SWEEP_INTERVAL=10m
IDEMPOTENCY_MAX_KEY_LENGTH=255

OTEL_TRACING_ENABLED=true
OTEL_EXPORTER=stdout
# Required when OTEL_EXPORTER is otlp, ignored otherwise.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1.0

# The runtime profiles. Off by default. When on, the listener binds 127.0.0.1
# only, so a profile is read through an exec into the container or a port
# forward, never from the network.
PPROF_ENABLED=false
PPROF_PORT=6060
